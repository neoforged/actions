{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "addLabels": ["dependencies"],
    "extends": ["group:recommended"],
    "env":{
      "GRADLE_USER_HOME": ".gradle/gradlehome",
      "_JAVA_OPTIONS": "-Duser.home=.gradle/usrhome"
    },
    "dependencyDashboard": true,
    "dependencyDashboardApproval": true,
    "dependencyDashboardLabels": ["dependencies"],
    "onboardingPrTitle": "Configure Renovate [skip ci]",
    "packageRules": [
        {
            "matchDatasources": ["maven"],
            "registryUrls": ["https://repo1.maven.org/maven2/", "https://plugins.gradle.org/m2/"]
        },
        {
            "matchDatasources": ["maven"],
            "matchPackagePatterns": [
                "^net\\.neoforged(\\.|:)",
                "^cpw\\.mods(\\.|:)",
                "^org\\.parchmentmc(\\.|:)",
                "^net\\.covers1624(\\.|:)"
            ],
            "registryUrls": ["https://maven.neoforged.net/releases"]
        },
        {
            "matchDatasources": ["maven"],
            "matchPackagePatterns": ["^net\\.fabricmc"],
            "registryUrls": ["https://maven.fabricmc.net"]
        },

        {
            "matchPackagePatterns": ["^net\\.neoforged\\.gradleutils"],
            "groupName": "gradleutils"
        },
        {
            "matchPackagePatterns": ["^net\\.neoforged\\.moddev", "^net\\.neoforged:moddev"],
            "groupName": "mdg"
        },
        {
            "matchPackagePatterns": ["^org\\.ow2\\.asm:asm.*"],
            "groupName": "asm"
        },

        {
            "__comment": "Yay for FML going from major 47 back to zero",
            "matchPackagePatterns": ["^net\\.neoforged\\.fancymodloader:"],
            "allowedVersions": "!/47\\..+/"
        },

        {
            "matchDepPatterns": [
                "^net\\.neoforged\\.fancymodloader:"
            ],
            "overrideDepName": "FancyModLoader"
        },
        {
            "matchDepPatterns": [
                "^net\\.neoforged:JarJar"
            ],
            "overrideDepName": "JarJar"
        },
        {
            "matchDepPatterns": [
                "^net\\.neoforged[.:]moddev"
            ],
            "overrideDepName": "ModDevGradle"
        },
        {
            "matchDepPatterns": [
                "^com\\.electronwill\\.night-config"
            ],
            "overrideDepName": "NightConfig"
        },
        {
            "matchPackageNames": [
                "net.fabricmc:sponge-mixin"
            ],
            "overrideDepName": "Mixin"
        },
        {
            "matchPackageNames": [
                "io.github.llamalad7:mixinextras-neoforge"
            ],
            "overrideDepName": "MixinExtras"
        },
        {
            "matchPackageNames": [
                "net.neoforged:accesstransformers"
            ],
            "overrideDepName": "AccessTransformers"
        },
        {
            "matchPackageNames": [
                "net.neoforged:mergetool"
            ],
            "overrideDepName": "MergeTool"
        },
        {
            "matchPackageNames": [
                "net.neoforged.installertools:installertools"
            ],
            "overrideDepName": "InstallerTools"
        },
        {
            "matchPackageNames": [
                "org.apache.maven:maven-artifact"
            ],
            "overrideDepName": "Maven Artifact"
        },
        {
            "matchPackageNames": [
                "org.mockito:mockito-core"
            ],
            "overrideDepName": "Mockito"
        },
        {
            "matchPackageNames": [
                "net.neoforged.jst:jst-cli-bundle"
            ],
            "overrideDepName": "JavaSourceTransformer"
        },
        {
            "matchPackageNames": [
                "org.eclipse.jdt:org.eclipse.jdt.core"
            ],
            "overrideDepName": "Eclipse JDT Core"
        },
        {
            "matchPackageNames": [
                "org.jetbrains:annotations"
            ],
            "overrideDepName": "JetBrains Annotations"
        },
        {
            "matchPackageNames": [
                "org.junit:junit-bom"
            ],
            "overrideDepName": "JUnit"
        },
        {
            "matchPackageNames": [
                "org.ow2.asm:asm"
            ],
            "overrideDepName": "ASM"
        },
        {
            "matchPackageNames": [
                "org.assertj:assertj-core"
            ],
            "overrideDepName": "AssertJ"
        },
        {
            "matchPackageNames": [
                "cpw.mods:securejarhandler"
            ],
            "overrideDepName": "SecureJarHandler"
        },
        {
            "matchPackageNames": [
                "net.neoforged:AutoRenamingTool"
            ],
            "overrideDepName": "AutoRenamingTool"
        },
        {
            "matchPackageNames": [
                "net.neoforged:bus"
            ],
            "overrideDepName": "Bus"
        },
        {
            "matchPackageNames": [
                "io.codechicken:DiffPatch"
            ],
            "overrideDepName": "DiffPatch"
        },
        {
            "matchPackageNames": [
                "org.openjdk.nashorn:nashorn-core"
            ],
            "overrideDepName": "Nashorn"
        }
    ],

    "presetCachePersistence": true
}
