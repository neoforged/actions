{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "github>neoforged/actions:renovate_preset",
        ":semanticCommitsDisabled"
    ],
    "baseBranches": [
        "$default",
        "26.1.x",
        "1.21.1"
    ],
    "prTitle": "[{{baseBranch}}] {{commitMessage}}",
    "prTitleStrict": true,

    "customManagers": [
        {
            "customType": "regex",
            "fileMatch": [
                "gradle\\.properties$"
            ],
            "matchStrings": [
                "# renovate: (?<depName>[\\w:\\.-]+)\\s+[A-Za-z_]+=(?<currentValue>[\\d\\.]+)"
            ],
            "datasourceTemplate": "maven"
        }
    ],
    "packageRules": [
        {
            "__comment__": "Disable major updates by default",
            "matchUpdateTypes": [
                "major"
            ],
            "enabled": false
        },
        {
            "__comment__": "Enable major updates on the default branch",
            "matchUpdateTypes": [
                "major"
            ],
            "matchBaseBranches": [
                "$default"
            ],
            "enabled": true
        },

        {
            "__comment__": "Avoid updating libs shipped by MC",
            "matchDepPatterns": [
                "^org\\.apache\\.commons:",
                "^org\\.apache\\.logging\\.log4j:",
                "^com\\.google\\.code\\.gson:gson"
            ],
            "enabled": false
        },

        {
            "matchDepNames": [
                "net.neoforged:minecraft-dependencies"
            ],
            "enabled": false
        },
        
        {
            "matchPackageNames": [
                "org.apache.maven:maven-artifact"
            ],
            "groupName": "maven-artifact"
        },

        {
            "matchDepPatterns": [
                "^net\\.neoforged\\.fancymodloader:"
            ],
            "overrideDepName": "FancyModLoader"
        },
        {
            "matchDepPatterns": [
                "^net\\.neoforged:JarJar"
            ],
            "overrideDepName": "JarJar"
        },
        {
            "matchDepPatterns": [
                "^net\\.neoforged[.:]moddev"
            ],
            "overrideDepName": "ModDevGradle"
        },
        {
            "matchDepPatterns": [
                "^com\\.electronwill\\.night-config"
            ],
            "overrideDepName": "NightConfig"
        },
        {
            "matchPackageNames": [
                "net.fabricmc:sponge-mixin"
            ],
            "overrideDepName": "Mixin"
        },
        {
            "matchPackageNames": [
                "io.github.llamalad7:mixinextras-neoforge"
            ],
            "overrideDepName": "MixinExtras"
        },
        {
            "matchDepNames": [
                "net.neoforged.jarcompatibilitychecker"
            ],
            "overrideDepName": "JarCompatibilityChecker"
        },
        {
            "matchPackageNames": [
                "net.neoforged:accesstransformers"
            ],
            "overrideDepName": "AccessTransformers"
        },
        {
            "matchPackageNames": [
                "net.neoforged:mergetool"
            ],
            "overrideDepName": "MergeTool"
        },
        {
            "matchPackageNames": [
                "net.neoforged.installertools:installertools"
            ],
            "overrideDepName": "InstallerTools"
        },
        {
            "matchPackageNames": [
                "dev.lukebemish.immaculate"
            ],
            "overrideDepName": "Immaculate"
        },
        {
            "matchPackageNames": [
                "org.apache.maven:maven-artifact"
            ],
            "overrideDepName": "Maven Artifact"
        },
        {
            "matchPackageNames": [
                "org.mockito:mockito-core"
            ],
            "overrideDepName": "Mockito"
        },
        {
            "matchPackageNames": [
                "net.neoforged.jst:jst-cli-bundle"
            ],
            "overrideDepName": "JavaSourceTransformer"
        },
        {
            "matchPackageNames": [
                "org.eclipse.jdt:org.eclipse.jdt.core"
            ],
            "overrideDepName": "Eclipse JDT Core"
        },
        {
            "matchPackageNames": [
                "org.jetbrains:annotations"
            ],
            "overrideDepName": "JetBrains Annotations"
        },
        {
            "matchPackageNames": [
                "org.junit:junit-bom"
            ],
            "overrideDepName": "JUnit"
        },
        {
            "matchPackageNames": [
                "org.ow2.asm:asm"
            ],
            "overrideDepName": "ASM"
        }
    ]
}
